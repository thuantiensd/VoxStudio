# Copy to .env.local and fill in your values.
# .env.local is gitignored.

# Backend API URL — point to your RunPod deployment.
# Dev default: http://localhost:8000 (local server)
VITE_API_URL=http://localhost:8000

# Optional: Clerk / Supabase auth (wired up in next iteration)
# VITE_CLERK_PUBLISHABLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
