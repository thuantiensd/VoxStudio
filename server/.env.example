# Device: cuda / mps / cpu (auto-detected if not set)
# DEVICE=mps

# Models (HuggingFace repo IDs)
# TTS_MODEL=k2-fsa/OmniVoice
# WHISPER_MODEL=openai/whisper-large-v3-turbo

# Server
# HOST=0.0.0.0
# PORT=8000

# JWT signing — tự sinh random 32+ ký tự (vd `openssl rand -base64 32`)
# JWT_SECRET=

# SMTP — gửi email verify. Dùng Gmail App Password (16 ký tự, bỏ dấu cách)
# Hướng dẫn: https://support.google.com/accounts/answer/185833
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER[email protected]
# SMTP_PASS=abcdefghijklmnop
# SMTP_FROM_NAME=VoxStudio

# Base URL của server — link verify email sẽ trỏ về URL này
# Local dev: http://localhost:8000
# Production: https://api.voxstudio.app
# APP_BASE_URL=http://localhost:8000

# Bank info cho thanh toán chuyển khoản. BIN list:
# https://www.vietqr.io/danh-sach-api/danh-sach-ngan-hang/
# BANK_NAME=Techcombank
# BANK_BIN=970407
# BANK_ACCOUNT_NO=19034291530012
# BANK_ACCOUNT_NAME=NGUYEN VAN A
