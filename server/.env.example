# ──────────────────────────────────────────────────────────────
# VoxStudio server — environment variables
# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# ──────────────────────────────────────────────────────────────

# ── Mode ──────────────────────────────────────────────────────
# Split deploy:
#   VPS API-only :  WORKER_ENABLED=false  + DEVICE=cpu
#   RunPod GPU   :  WORKER_ENABLED=true   + DEVICE=cuda
# WORKER_ENABLED=true
# DEVICE=mps        # cuda | mps | cpu (auto-detect nếu để trống)

# ── Models (HuggingFace repo IDs) ─────────────────────────────
# TTS_MODEL=k2-fsa/OmniVoice
# WHISPER_MODEL=openai/whisper-large-v3-turbo
# FASTER_WHISPER_MODEL=large-v3-turbo
# USE_FASTER_WHISPER=true

# ── Server ────────────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# APP_BASE_URL=http://localhost:8000   # production: https://api.voxstudio.vn

# ── Database ──────────────────────────────────────────────────
# Local dev:  để trống → SQLite (server/voxstudio.db)
# Production: DATABASE_URL=postgresql+asyncpg://voxstudio:<PASSWORD>@<HOST>:5432/voxstudio
# DATABASE_URL=

# ── JWT ───────────────────────────────────────────────────────
# Tự sinh random 32+ ký tự: `openssl rand -base64 32`
# Cùng giá trị trên VPS API và RunPod worker để token verify được.
# JWT_SECRET=

# ── Storage backend ───────────────────────────────────────────
# "local" = filesystem (dev, single-node)
# "r2"    = Cloudflare R2 (production, split VPS + RunPod)
# STORAGE_BACKEND=local

# Cloudflare R2 — chỉ cần khi STORAGE_BACKEND=r2
# Account ID lấy từ R2 dashboard (sidebar phải, hoặc URL).
# R2_ACCOUNT_ID=

# API token: Cloudflare → R2 → Manage R2 API Tokens → Create
# Permissions: Object Read & Write, scoped to 2 bucket dưới.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Bucket names (tạo bên Cloudflare R2 dashboard, location APAC).
# R2_BUCKET_PUBLIC=voxstudio-public
# R2_BUCKET_PRIVATE=voxstudio-private

# Public URL prefix cho audio output. 2 lựa chọn:
#  1. Dev URL R2 (nhanh):     https://pub-<random>.r2.dev
#  2. Custom domain (chuẩn):   https://files.voxstudio.vn
# R2_PUBLIC_URL=https://pub-4871d3321c714210be97e3a36a9f46e3.r2.dev

# Endpoint S3-compatible — auto build từ R2_ACCOUNT_ID nếu để trống.
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# ── Storage paths (override khi mount network volume RunPod) ──
# RunPod thường mount /workspace, đặt path R2 cache + voices ở đó.
# VOICES_DIR=/workspace/voices
# AUDIO_OUTPUT_DIR=/workspace/audio_output
# DUBBING_PROJECTS_DIR=/workspace/dubbing_projects
# WORKER_TMP_DIR=/workspace/tmp/voxstudio-worker

# ── HuggingFace cache ─────────────────────────────────────────
# Để model download cache vào network volume tránh re-download mỗi cold start.
# HF_HOME=/workspace/hf_cache
# TRANSFORMERS_CACHE=/workspace/hf_cache
# HF_TOKEN=                      # cần nếu dùng pyannote (gated model)

# ── Email (SMTP cho verify + reset password) ──────────────────
# Gmail App Password (16 ký tự, bỏ dấu cách):
# https://support.google.com/accounts/answer/185833
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=abcdefghijklmnop
# SMTP_FROM_NAME=VoxStudio

# ── Bank thanh toán (VietQR) ──────────────────────────────────
# BIN list: https://www.vietqr.io/danh-sach-api/danh-sach-ngan-hang/
# BANK_NAME=Techcombank
# BANK_BIN=970407
# BANK_ACCOUNT_NO=19034291530012
# BANK_ACCOUNT_NAME=NGUYEN VAN A

# ── Translate APIs ────────────────────────────────────────────
# GEMINI_API_KEY=

# ── Admin ─────────────────────────────────────────────────────
# Email phân tách bằng dấu phẩy — user tạo bằng email này tự động role=admin
# ADMIN_EMAILS=admin@voxstudio.vn

# ── Sentry (error tracking, optional) ─────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENV=production
# SENTRY_RELEASE=voxstudio-server@0.1.0

# ── DEPRECATED — không cần khi STORAGE_BACKEND=r2 ─────────────
# Trước đây worker SCP file từ VPS qua SSH. Khi đổi sang R2 → xoá biến này.
# VPS_FILE_HOST=root@<VPS_PUBLIC_IP>
